<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sesión cerrada | Prime Suplementos</title>
  </head>
  <body>
    <main>
      <div class="icono">✓</div>
      <h1>Sesión cerrada</h1>
      <p>Cerraste sesión correctamente.</p>
      <a class="boton principal" href="/login">Volver a iniciar sesión</a>
      <a class="boton secundario" href="/">Ir a la tienda</a>
    </main>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: #f7f7f5;
    color: #111;
    font-family: system-ui, sans-serif;
  }
  main {
    width: 100%;
    max-width: 380px;
    padding: 32px 24px;
    text-align: center;
    background: #fff;
    border: 1px solid #e8e4dc;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.06);
  }
  .icono {
    width: 56px;
    height: 56px;
    margin: 0 auto;
    border-radius: 50%;
    background: #111;
    color: #fff;
    font-size: 28px;
    line-height: 56px;
  }
  h1 { margin: 16px 0 8px; font-size: 24px; }
  p { margin: 0 0 24px; color: #666; }
  .boton {
    display: block;
    margin-top: 12px;
    padding: 12px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
  }
  .principal { background: #111; color: #fff; }
  .principal:hover { background: #a8763e; }
  .secundario { border: 1px solid #d9d5cb; color: #111; }
  .secundario:hover { border-color: #a8763e; color: #a8763e; }
</style>