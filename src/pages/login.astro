---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/loginform.jsx';
import '../styles/global.css';
---

<Layout title="Iniciar Sesión - Prime Suplementos">
  <main class="min-h-screen bg-gradient-to-br from-[#F5EDE0] via-[#E2D1B3] to-[#F5EDE0] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <!-- Logo y título -->
      <div class="text-center mb-8">
        <div class="w-20 h-20 mx-auto rounded-full border-4 border-orange-500 shadow-lg overflow-hidden bg-white mb-4">
          <img src="/images/logo.jpeg" alt="Logo Prime Suplementos" class="w-full h-full object-cover" />
        </div>
        <h1 class="text-2xl font-bold text-[#3d2314]">Prime Suplementos</h1>
        <p class="text-[#5c4033] mt-2">Panel de Administración</p>
      </div>
      
      <!-- Formulario de login -->
      <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 border border-[#C9B896]">
        <LoginForm client:load />
      </div>
      
      <!-- Link para volver -->
      <div class="text-center mt-6">
        <a href="/" class="text-[#5c4033] hover:text-orange-600 transition-colors">
          ← Volver a la tienda
        </a>
      </div>
    </div>
  </main>
</Layout>
