---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/loginform.jsx';
import '../styles/global.css';
---

<Layout title="Iniciar Sesión - Prime Suplementos">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-white px-4 py-12">
    <div class="w-full max-w-md">
      <!-- Identidad y título -->
      <div class="relative z-10 mb-8 text-center">
        <div class="mx-auto mb-5 h-20 w-20">
          <img src="/images/logo-transparent.png" alt="Prime Suplementos" class="h-full w-full object-contain" />
        </div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.3em] text-[#c68b52]">Acceso privado</p>
        <h1 class="text-3xl font-black uppercase tracking-tight text-[#171717]">Prime <span class="text-[#c68b52]">Suplementos</span></h1>
        <p class="mt-2 text-black/55">Panel de Administración</p>
      </div>
      
      <!-- Formulario de login -->
      <div class="relative z-10 rounded-sm border border-white/10 bg-white p-3 shadow-[0_20px_60px_rgba(0,0,0,0.35)] md:p-4">
        <LoginForm client:load />
      </div>
      
      <!-- Link para volver -->
      <div class="relative z-10 mt-6 text-center">
        <a href="/" class="text-sm text-black/60 transition-colors hover:text-[#c68b52]">
          ← Volver a la tienda
        </a>
      </div>
    </div>
  </main>
</Layout>
