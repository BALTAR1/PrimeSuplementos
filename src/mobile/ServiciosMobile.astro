---
import { whatsappConfig, buildWhatsappUrl } from '../config/whatsappMessages.js';
---

<section class="w-full py-12 md:py-16 bg-[#f7f7f5]">
  <div class="px-4">
    <h1 class="text-3xl font-black text-[#111] mb-4 text-center tracking-tight leading-tight uppercase">
      <span class="font-light text-black/55">Venta</span> <span class="text-[#a8763e] font-black">Mayorista</span> <span class="font-light text-black/55">vs</span> <span class="text-[#111] font-black">Minorista</span>
    </h1>
    <p class="text-base md:text-lg max-w-3xl mx-auto text-center mb-8 text-black/55 font-semibold">
      Soluciones flexibles para tu negocio o tu gimnasio.
    </p>

    <div class="space-y-6">
      <!-- Card Mayorista Mobile -->
      <div class="business-card relative bg-white border border-[#a8763e]/50 shadow-lg rounded-sm p-6 flex flex-col transition-all duration-300">
        <div class="absolute top-0 right-0 w-24 h-24 bg-orange-400/10 rounded-br-xl rounded-tl-full opacity-40 -z-10"></div>
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-gradient-to-br from-orange-400 to-orange-600 text-white p-3 rounded-full flex items-center justify-center shadow-lg flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20z"/><path d="M8 12h8" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <div>
            <h2 class="text-xl font-black text-[#a8763e] leading-tight">Mayorista</h2>
            <p class="text-sm text-[#5c4033] font-semibold">Para tu gimnasio</p>
          </div>
        </div>
        <p class="text-[#5c4033] text-sm mb-3 font-medium">Ideal para gimnasios, tiendas fitness y distribuidores que buscan los mejores precios.</p>
        <ul class="mb-4 space-y-2 text-sm text-[#5c4033]">
          <li class="flex items-start gap-2"><span class="text-orange-500 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg></span><span><b class="font-bold text-[#3d2314]">Compra en Volumen</b> desde 50 unidades</span></li>
          <li class="flex items-start gap-2"><span class="text-orange-500 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16"/><path d="M4 12h16"/></svg></span><span><b class="font-bold text-[#3d2314]">Descuentos Exclusivos</b> hasta 40%</span></li>
          <li class="flex items-start gap-2"><span class="text-orange-500 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12h18"/><path d="M12 3v18"/></svg></span><span><b class="font-bold text-[#3d2314]">Márgenes Competitivos</b></span></li>
          <li class="flex items-start gap-2"><span class="text-orange-500 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg></span><span><b class="font-bold text-[#3d2314]">Asesoría Personalizada</b></span></li>
          <li class="flex items-start gap-2"><span class="text-orange-500 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v8"/><path d="M8 16h8"/></svg></span><span><b class="font-bold text-[#3d2314]">Envíos Programados</b></span></li>
        </ul>
        <a href={buildWhatsappUrl(whatsappConfig.mayorista)} target="_blank" rel="noopener" class="w-full inline-block bg-[#a8763e] hover:bg-[#c68b52] text-white font-bold py-2 px-4 rounded-sm transition-colors text-center shadow-lg text-sm uppercase tracking-wider">Contactar</a>
      </div>

      <!-- Card Minorista Mobile -->
      <div class="business-card relative bg-white border border-black/20 shadow-lg rounded-sm p-6 flex flex-col transition-all duration-300">
        <div class="absolute top-0 left-0 w-24 h-24 bg-[#3d2314]/10 rounded-bl-xl rounded-tr-full opacity-40 -z-10"></div>
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-gradient-to-br from-[#5c4033] to-[#3d2314] text-white p-3 rounded-full flex items-center justify-center shadow-lg flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20z"/><path d="M16 12h-8" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <div>
            <h2 class="text-xl font-black text-[#3d2314] leading-tight">Minorista</h2>
            <p class="text-sm text-[#5c4033] font-semibold">Para vos</p>
          </div>
        </div>
        <p class="text-[#5c4033] text-sm mb-3 font-medium">Perfecto para deportistas que buscan suplementos de calidad.</p>
        <ul class="mb-4 space-y-2 text-sm text-[#5c4033]">
          <li class="flex items-start gap-2"><span class="text-[#5c4033] flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M16 12h-8"/></svg></span><span><b class="font-bold text-[#3d2314]">Compra por Unidad</b> sin mínimos</span></li>
          <li class="flex items-start gap-2"><span class="text-[#5c4033] flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 19V5"/><path d="M5 12h14"/></svg></span><span><b class="font-bold text-[#3d2314]">Entrega Rápida</b> 24-48 horas</span></li>
          <li class="flex items-start gap-2"><span class="text-[#5c4033] flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg></span><span><b class="font-bold text-[#3d2314]">Variedad de Productos</b></span></li>
          <li class="flex items-start gap-2"><span class="text-[#5c4033] flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 17h16"/><path d="M4 21h16"/></svg></span><span><b class="font-bold text-[#3d2314]">Promociones Semanales</b></span></li>
          <li class="flex items-start gap-2"><span class="text-[#5c4033] flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v8"/><path d="M8 16h8"/></svg></span><span><b class="font-bold text-[#3d2314]">Atención Personalizada</b></span></li>
        </ul>
        <a href="/productos" class="w-full inline-block bg-[#111] hover:bg-[#a8763e] text-white font-bold py-2 px-4 rounded-sm transition-colors text-center shadow-lg text-sm uppercase tracking-wider">Comprar Ahora</a>
      </div>
    </div>
  </div>
</section>

<style>
  .business-card.is-focused {
    transform: translateY(-5px);
    border-color: #a8763e;
  }
</style>

<script>
  const mobileBusinessCards = document.querySelectorAll('.business-card');
  mobileBusinessCards.forEach((card) => {
    card.addEventListener('pointerenter', () => card.classList.add('is-focused'));
    card.addEventListener('pointerleave', () => card.classList.remove('is-focused'));
  });
</script>
