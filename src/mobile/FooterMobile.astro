---
// Footer Mobile - Versión compacta y optimizada
---

<footer class="w-full text-white py-10 bg-[#090909]">
  <div class="px-4 max-w-md mx-auto">
    {/* Logo y descripción */}
    <div class="text-center mb-6">
      <img 
        src="/images/logo.jpeg" 
        alt="Prime Suplementos" 
        class="w-24 h-24 mx-auto mb-3 object-contain"
      />
      <h3 class="text-xl font-black text-white mb-1 uppercase tracking-wider">Prime <span class="text-[#c68b52]">Suplementos</span></h3>
      <p class="text-sm text-white/50">
        Tu tienda de suplementos deportivos de confianza
      </p>
    </div>

    {/* Enlaces rápidos */}
    <div class="grid grid-cols-2 gap-4 mb-6 text-center">
      <div>
        <h4 class="text-sm font-semibold mb-2 text-[#c68b52]">Productos</h4>
        <ul class="space-y-1 text-xs text-white/60">
          <li><a href="/productos" class="hover:text-[#c68b52] transition-colors">Catálogo</a></li>
          <li><a href="/combos" class="hover:text-[#c68b52] transition-colors">Combos</a></li>
          <li><a href="/categoria/ofertas" class="hover:text-[#c68b52] transition-colors">Ofertas</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold mb-2 text-[#c68b52]">Contacto</h4>
        <ul class="space-y-1 text-xs text-white/60">
          <li><a href="https://www.instagram.com/primesuples.sj/" class="hover:text-[#c68b52] transition-colors">Instagram</a></li>
          <li><a href="/#contacto" class="hover:text-[#c68b52] transition-colors">Asesoramiento</a></li>
        </ul>
      </div>
    </div>

    {/* Redes sociales */}
    <div class="flex justify-center gap-4 mb-6">
      <a href="#" class="w-10 h-10 bg-gray-200/10 border border-gray-700/20 rounded-full flex items-center justify-center hover:bg-orange-500 hover:border-orange-500 transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="#" class="w-10 h-10 bg-gray-200/10 border border-gray-700/20 rounded-full flex items-center justify-center hover:bg-gradient-to-br hover:from-purple-600 hover:to-pink-500 hover:border-pink-500 transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
    </div>

    {/* Copyright */}
    <div class="text-center pt-6 border-t border-black/20">
      <p class="text-xs text-white/40">
        © {new Date().getFullYear()} Prime Suplementos. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
