---
// Hero Mobile
---

<section class="relative w-full h-[60vh] min-h-[400px] overflow-hidden" style="background: linear-gradient(to bottom right, #F5EDE0, #E2D1B3);">
  {/* Contenido principal */}
  <div class="relative z-10 flex flex-col items-center justify-center h-full px-4 text-center">
    <img 
      src="/images/logo.jpeg" 
      alt="Logo Prime Suplementos" 
      class="w-24 h-24 rounded-full border-4 border-orange-400 shadow-lg mb-4 object-cover"
    />
    <h1 class="text-3xl font-black text-[#3d2314] mb-1">
      Prime <span class="text-orange-500">Suplementos</span>
    </h1>
    <div class="flex flex-col gap-3 w-full max-w-xs mt-6">
      <a 
        href="/productos" 
        class="px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-bold rounded-full shadow-lg hover:from-orange-600 hover:to-orange-700 transition-all text-center"
      >
        Ver productos
      </a>
      <a 
        href="/combos" 
        class="px-6 py-3 bg-gradient-to-r from-[#5c4033] to-[#3d2314] text-white font-bold rounded-full shadow-lg hover:from-[#3d2314] hover:to-[#2a1810] transition-all text-center"
      >
        Ver combos
      </a>
    </div>
  </div>
</section>
