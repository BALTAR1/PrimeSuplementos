---
// Hero Mobile
---

<section class="relative w-full min-h-[520px] overflow-hidden bg-[#090909]">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(198,139,82,0.3),transparent_38%)]"></div>
  <div class="absolute -right-24 top-24 h-64 w-64 rounded-full border border-[#c68b52]/20"></div>
  <div class="absolute -left-32 bottom-8 h-72 w-72 rounded-full border border-white/5"></div>
  <div class="absolute inset-x-8 top-24 h-px bg-gradient-to-r from-transparent via-[#c68b52]/40 to-transparent"></div>

  <div class="relative z-10 flex min-h-[520px] flex-col items-center justify-center px-5 text-center">
    <p class="mb-5 text-[10px] font-bold uppercase tracking-[0.4em] text-[#c68b52]">
      Rendimiento que se siente
    </p>
    <h1 class="max-w-sm text-5xl font-black uppercase leading-[0.9] tracking-tight text-white">
      Potenciá tu
      <span class="block text-[#c68b52]">mejor versión</span>
    </h1>
    <p class="mt-6 max-w-xs text-sm leading-relaxed text-white/60">
      Suplementación de calidad para acompañar cada objetivo.
    </p>
    <div class="mt-6 flex items-center gap-3 text-[9px] font-bold uppercase tracking-[0.25em] text-white/40">
      <span class="h-px w-8 bg-[#c68b52]"></span>
      Fuerza <span class="text-[#c68b52]">•</span> Energía <span class="text-[#c68b52]">•</span> Resultados
      <span class="h-px w-8 bg-[#c68b52]"></span>
    </div>
    <div class="flex flex-col gap-3 w-full max-w-xs mt-6">
      <a 
        href="/productos" 
        class="px-6 py-3 bg-[#a8763e] text-white font-bold rounded-sm shadow-lg hover:bg-[#c68b52] transition-all text-center uppercase tracking-wider"
      >
        Ver productos
      </a>
      <a 
        href="/combos" 
        class="px-6 py-3 border border-white/40 text-white font-bold rounded-sm hover:bg-white hover:text-black transition-all text-center uppercase tracking-wider"
      >
        Ver combos
      </a>
    </div>
  </div>
</section>
