---
// Categorías Mobile - Una categoría por bloque para navegación vertical
const categorias = [
  { id: 1, nombre: 'Proteínas', imagen: '/images/catproteinas.png' },
  { id: 2, nombre: 'Creatinas', imagen: '/images/catcreatinas.png' },
  { id: 3, nombre: 'Vitaminas', imagen: '/images/catvitaminas.png' },
  { id: 4, nombre: 'Aminoacidos', imagen: '/images/cataminoacidos.png' },
  { id: 5, nombre: 'Preentrenos', imagen: '/images/catpreentrenos.png' },
];

const crearSlug = (nombre) => nombre
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase();
---

<section class="w-full bg-[#111111] py-6">
  <div class="px-4">
    <h2 class="mb-2 text-2xl font-black uppercase tracking-wider text-center text-white">
      <span class="text-[#c68b52]">Categorías</span>
    </h2>
    
    <div class="categorias-mobile-carousel h-[48vh] snap-y snap-mandatory overflow-y-auto overscroll-contain scroll-smooth touch-pan-y">
        {categorias.map((categoria) => (
          <a 
            href={`/productos?categoria=${crearSlug(categoria.nombre)}`}
            class="flex h-full shrink-0 snap-start items-center justify-center py-3"
          >
            <div class="categoria-mobile-card w-[78%] max-w-[290px] overflow-hidden rounded-2xl border border-white/15 bg-gradient-to-br from-[#242424] to-[#151515] shadow-[0_18px_45px_rgba(0,0,0,0.35)]">
              <div class="relative aspect-[1/0.9] overflow-hidden bg-[#222]">
                <img 
                  src={categoria.imagen} 
                  alt={categoria.nombre}
                  loading={categoria.id === 1 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <p class="absolute bottom-4 left-0 right-0 text-center text-xl font-black uppercase tracking-widest text-white drop-shadow-lg">
                  {categoria.nombre}
                </p>
              </div>
              <div class="flex items-center justify-between px-5 py-4">
                <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#c68b52]">Explorar</span>
                <span class="text-lg text-white/70" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
    </div>
  </div>
</section>

<style>
  .categorias-mobile-carousel {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .categorias-mobile-carousel::-webkit-scrollbar {
    display: none;
  }

  .categoria-mobile-card {
    transition: transform 300ms ease, box-shadow 300ms ease;
  }

  .categoria-mobile-card:active {
    transform: scale(0.98);
  }

  .categoria-mobile-card:active img {
    transform: scale(1.04);
  }
</style>
