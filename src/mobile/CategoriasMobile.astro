---
// Categorías Mobile - Carrusel optimizado para móviles
const categorias = [
  { id: 1, nombre: 'Proteínas', imagen: '/images/catproteinas.png' },
  { id: 2, nombre: 'Creatinas', imagen: '/images/catcreatinas.png' },
  { id: 3, nombre: 'Vitaminas', imagen: '/images/catvitaminas.png' },
  { id: 4, nombre: 'Aminoacidos', imagen: '/images/cataminoacidos.png' },
  { id: 5, nombre: 'Preentrenos', imagen: '/images/catpreentrenos.png' },
];
---

<section class="w-full py-8" style="background-color: #F5EDE0;">
  <div class="px-4">
    <h2 class="text-2xl font-black text-[#3d2314] text-center mb-6">
      <span class="text-orange-500">Categorías</span>
    </h2>
    
    {/* Carrusel horizontal para mobile */}
    <div class="overflow-x-auto pb-4 hide-scrollbar">
      <div class="flex gap-4 px-2">
        {categorias.map((categoria) => (
          <a 
            href={`/categoria/${categoria.nombre.toLowerCase()}`}
            class="flex-shrink-0 w-32"
          >
            <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-all overflow-hidden border border-[#C9B896]">
              <div class="relative h-32 bg-[#F5EDE0]">
                <img 
                  src={categoria.imagen} 
                  alt={categoria.nombre}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-2">
                <p class="text-sm font-bold text-[#3d2314] text-center">
                  {categoria.nombre}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}
.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
</style>
