---
const marcas = [
  { id: 1, nombre: 'HTN', imagen: '/images/marcas/logohtn.png' },
  { id: 2, nombre: 'Star Nutrition', imagen: '/images/marcas/logostar.png' },
  { id: 3, nombre: 'ENA Sport', imagen: '/images/marcas/logoena.png' },
  { id: 4, nombre: 'Mervick Lab', imagen: '/images/marcas/logomervick.png' },
  { id: 5, nombre: 'Granger', imagen: '/images/marcas/logogranger.png' },
  { id: 6, nombre: 'GOLD Nutrition', imagen: '/images/marcas/logogold.png' },
  { id: 7, nombre: 'Hoch Sport', imagen: '/images/marcas/logohochsport.png' },
  { id: 8, nombre: 'Ultra Tech', imagen: '/images/marcas/logoultratech.png' },
  { id: 9, nombre: 'Vitaminway', imagen: '/images/marcas/logovitamin.png' },
  { id: 10, nombre: 'Xtrenght Nutrition', imagen: '/images/marcas/logoxtrenght.png' }
];
---

<section class="w-full py-20 md:py-28 bg-[#f7f7f5]">
  <div class="max-w-7xl mx-auto px-4 md:px-10">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-6xl font-black text-[#111] mb-3 uppercase tracking-tight">
        Marcas de <span class="text-[#c68b52]">Confianza</span>
      </h2>
      <p class="text-lg md:text-xl text-black/55 max-w-2xl mx-auto font-medium">
        Trabajamos con las marcas líderes del mercado para ofrecerte los mejores productos.
      </p>
    </div>

    <div id="marcasCarousel" class="overflow-hidden pb-5 hide-scrollbar">
      <div class="marcas-track flex w-max gap-5 px-2">
        {[...marcas, ...marcas].map((marca, index) => (
          <div class="group flex-none w-44 h-36 md:w-56 md:h-40 bg-white rounded-sm p-6 shadow-lg hover:shadow-2xl hover:shadow-[#a8763e]/20 transition-all duration-300 border border-black/10 hover:border-[#c68b52] flex flex-col items-center justify-center snap-center">
            <img src={marca.imagen} alt={`Logo de ${marca.nombre}`} aria-hidden={index >= marcas.length ? 'true' : undefined} class="w-full h-20 object-contain transition-all duration-300 group-hover:scale-105" loading="lazy" />
            <span class="text-[10px] uppercase tracking-wider text-black/45 mt-3">{marca.nombre}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .marcas-track {
    animation: marcas-infinito 38s linear infinite;
  }
  .marcas-track:hover {
    animation-play-state: paused;
  }
  @keyframes marcas-infinito {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 0.625rem)); }
  }
</style>
