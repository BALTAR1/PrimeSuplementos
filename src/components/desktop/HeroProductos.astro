<section class="relative w-full overflow-hidden bg-[#090909] min-h-[220px] sm:min-h-[260px] md:min-h-[310px] flex items-center">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_35%,rgba(198,139,82,0.28),transparent_38%)]" />
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-12 md:px-12 md:py-16">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-[#c68b52]">Prime Suplementos</p>
    <h1 class="max-w-2xl text-4xl font-black uppercase leading-[0.95] text-white sm:text-5xl md:text-7xl">
      Encontrá lo que<br />
