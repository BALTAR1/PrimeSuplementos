---
interface Producto {
  producto_id: number;
  nombre: string;
  descripcion?: string;
  precio: number;
  imagen_url?: string;
}

interface Props {
  productos?: Producto[];
}

const { productos = [] } = Astro.props;

// Formatear precio
function formatearPrecio(precio: number): string {
  return new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(precio);
}
---

<section class="w-full py-24 md:py-32 relative overflow-hidden bg-[#f7f7f5]">
  <div class="text-center mb-10 relative z-10">
    <h1 class="text-3xl md:text-6xl font-black text-[#111] mb-3 mt-4 uppercase tracking-tight">Productos
      <span class="text-[#a8763e] font-black">Destacados</span>
    </h1>
    <p class="text-black/55 text-lg md:text-xl max-w-2xl mx-auto">Los productos más elegidos para acompañar tu entrenamiento.</p>
  </div>

  {productos.length > 0 ? (
    <!-- Contenedor: deja 64px a cada lado (px-16) donde van las flechas, fuera de las tarjetas -->
    <div class="relative mx-auto w-full max-w-[1480px] px-16">
      <div id="sliderDestacados" class="slider-destacados flex gap-6 overflow-x-hidden pb-4 hide-scrollbar">
        {productos.map((producto) => (
          <div class="bg-white rounded-sm shadow-xl border border-black/10 flex flex-col p-6 items-center hover:shadow-2xl hover:shadow-[#a8763e]/20 transition-all duration-300 hover:-translate-y-1" style="flex: 0 0 320px; width: 320px;">
            <img src={producto.imagen_url || '/images/desta.svg'} alt={producto.nombre} loading="lazy" decoding="async" class="w-28 h-28 object-contain mb-4 mx-auto" />
            <h2 class="text-lg md:text-xl font-bold text-[#111] mb-1 text-center md:min-h-[56px] flex items-center justify-center">{producto.nombre}</h2>
            <p class="text-sm md:text-base text-gray-500 mb-3 text-center line-clamp-2 min-h-[40px]">{producto.descripcion || 'Sin descripción'}</p>
            <div class="flex-1 flex flex-col justify-end items-center w-full">
              <div class="text-2xl md:text-3xl font-extrabold text-[#a8763e] mb-2 text-center">{formatearPrecio(producto.precio)}</div>
              <a href={"/producto/" + producto.producto_id} class="w-full py-2 rounded-sm bg-[#111] text-white font-semibold shadow hover:bg-[#a8763e] transition-all text-center block text-base md:text-lg">
                Ver producto
              </a>
            </div>
          </div>
        ))}
      </div>
      {/* Flechas: quedan en el margen lateral, al lado de las tarjetas y nunca encima */}
      <button id="prevDestacados" aria-label="Anterior" class="hidden md:flex items-center justify-center absolute left-2 top-1/2 -mt-2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/90 shadow-lg hover:bg-orange-100 z-10 border border-slate-300 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button id="nextDestacados" aria-label="Siguiente" class="hidden md:flex items-center justify-center absolute right-2 top-1/2 -mt-2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/90 shadow-lg hover:bg-orange-100 z-10 border border-slate-300 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  ) : (
    <div class="text-center py-12">
      <p class="text-slate-400 text-lg">No hay productos destacados en este momento.</p>
    </div>
  )}

  <!-- Botones de Exploración -->
  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <a href="/productos" class="inline-flex items-center gap-2 px-8 py-3 bg-white hover:bg-[#111] hover:text-white text-[#111] font-semibold rounded-sm shadow-lg hover:shadow-xl transition-all duration-300 text-lg uppercase tracking-wider">
      Explorar catálogo
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
    <a href="/combos" class="inline-flex items-center gap-2 px-8 py-3 bg-[#a8763e] hover:bg-[#c68b52] text-white font-semibold rounded-sm shadow-lg hover:shadow-xl transition-all duration-300 text-lg uppercase tracking-wider">
      Ver combos
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</section>

<style>
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}
.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Centra las tarjetas cuando hay pocas (sobra espacio).
   Cuando hay más de las que caben, los márgenes valen 0 y el scroll funciona normal. */
.slider-destacados > :first-child {
  margin-left: auto;
}
.slider-destacados > :last-child {
  margin-right: auto;
}
</style>

<script>
// Slider: muestra las tarjetas que entren en pantalla y avanza de a "página".
// La cantidad por página se calcula según el ancho real, así funciona en cualquier pantalla.
// Se tipan como HTMLElement (no null) para que TypeScript no se queje dentro de las funciones.
// Igual se verifica que existan antes de usarlos (if de abajo).
const slider = document.getElementById('sliderDestacados') as HTMLElement;
const prev = document.getElementById('prevDestacados') as HTMLElement;
const next = document.getElementById('nextDestacados') as HTMLElement;

if (slider && prev && next) {
  const cardWidth = 320; // ancho de cada card
  const gap = 24;        // gap-6 = 1.5rem = 24px
  let currentPage = 0;

  function medidas() {
    const paso = cardWidth + gap;
    const visibles = Math.max(1, Math.floor((slider.clientWidth + gap) / paso));
    const totalPages = Math.ceil(slider.children.length / visibles);
    return { paso, visibles, totalPages };
  }

  function updateSlider() {
    const { paso, visibles, totalPages } = medidas();

    // Si todas las cards entran en una sola página, no hacen falta las flechas
    if (totalPages <= 1) {
      prev.style.display = 'none';
      next.style.display = 'none';
      slider.scrollTo({ left: 0 });
      currentPage = 0;
      return;
    }
    prev.style.display = '';
    next.style.display = '';

    currentPage = Math.min(currentPage, totalPages - 1);
    slider.scrollTo({ left: currentPage * visibles * paso, behavior: 'smooth' });

    // Actualizar estado de los botones
    prev.style.opacity = currentPage === 0 ? '0.5' : '1';
    prev.style.pointerEvents = currentPage === 0 ? 'none' : 'auto';
    next.style.opacity = currentPage >= totalPages - 1 ? '0.5' : '1';
    next.style.pointerEvents = currentPage >= totalPages - 1 ? 'none' : 'auto';
  }

  prev.addEventListener('click', () => {
    if (currentPage > 0) {
      currentPage--;
      updateSlider();
    }
  });

  next.addEventListener('click', () => {
    const { totalPages } = medidas();
    if (currentPage < totalPages - 1) {
      currentPage++;
      updateSlider();
    }
  });

  // Recalcula si cambia el tamaño de la ventana
  window.addEventListener('resize', updateSlider);

  // Inicializa en la primera página
  updateSlider();
}
</script>

